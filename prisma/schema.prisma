generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "core", "gamification", "geo", "social"]
}

model Authorities {
  id                  String                @id(map: "PK_Authorities") @default(dbgenerated("newsequentialid()"), map: "DF_Authorities_id") @db.UniqueIdentifier
  user_id             String                @unique(map: "UQ_Authorities_user_id") @db.UniqueIdentifier
  institutional_id    String                @unique(map: "UQ_Authorities_institutional_id") @db.NVarChar(50)
  department          String                @db.NVarChar(150)
  position            String                @db.NVarChar(100)
  institutional_email String                @db.NVarChar(256)
  permission_level    Int                   @default(1, map: "DF_Authorities_permission_level")
  can_schedule_alerts Boolean               @default(true, map: "DF_Authorities_can_schedule_alerts")
  is_verified         Boolean               @default(true, map: "DF_Authorities_is_verified")
  created_at          DateTime              @default(dbgenerated("sysdatetime()"), map: "DF_Authorities_created_at")
  Users               Users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_Authorities_Users")
  OfficialReports     OfficialReports[]
  ReportCancellations ReportCancellations[]
  ReportConfirmations ReportConfirmations[]
  ReportResolutions   ReportResolutions[]
  Reports             Reports[]

  @@schema("auth")
}

model Badges {
  id                     Int          @id(map: "PK_Badges") @default(autoincrement())
  code                   String       @unique(map: "UQ_Badges_code") @db.NVarChar(50)
  name                   String       @db.NVarChar(100)
  description            String       @db.NVarChar(256)
  icon_url               String       @db.NVarChar(512)
  required_level         Int          @default(1, map: "DF_Badges_required_level")
  required_action_points Int          @default(0, map: "DF_Badges_required_action_points")
  created_at             DateTime     @default(dbgenerated("sysdatetime()"), map: "DF_Badges_created_at")
  UserBadges             UserBadges[]

  @@schema("gamification")
}

model Denuncias {
  id                                      String   @id(map: "PK_Denuncias") @default(dbgenerated("newsequentialid()"), map: "DF_Denuncias_id") @db.UniqueIdentifier
  reporter_user_id                        String   @db.UniqueIdentifier
  reported_user_id                        String?  @db.UniqueIdentifier
  reported_report_id                      String?  @db.UniqueIdentifier
  reason                                  String   @db.NVarChar(500)
  status                                  String   @default("PENDING", map: "DF_Denuncias_status") @db.NVarChar(20)
  created_at                              DateTime @default(dbgenerated("sysdatetime()"), map: "DF_Denuncias_created_at")
  Reports                                 Reports? @relation(fields: [reported_report_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Denuncias_ReportedReport")
  Users_Denuncias_reported_user_idToUsers Users?   @relation("Denuncias_reported_user_idToUsers", fields: [reported_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Denuncias_ReportedUser")
  Users_Denuncias_reporter_user_idToUsers Users    @relation("Denuncias_reporter_user_idToUsers", fields: [reporter_user_id], references: [id], onUpdate: NoAction, map: "FK_Denuncias_ReporterUser")

  @@schema("social")
}

model IncidentTypes {
  id                     Int               @id(map: "PK_IncidentTypes") @default(autoincrement())
  code                   String            @unique(map: "UQ_IncidentTypes_code") @db.NVarChar(50)
  name                   String            @db.NVarChar(100)
  description            String?           @db.NVarChar(500)
  default_duration_hours Int               @default(24, map: "DF_IncidentTypes_default_duration")
  available_for          String            @default("AMBOS", map: "DF_IncidentTypes_available_for") @db.NVarChar(20)
  OfficialReports        OfficialReports[]
  Reports                Reports[]

  @@schema("core")
}

model MobilityLayers {
  id           Int      @id(map: "PK_MobilityLayers") @default(autoincrement())
  layer_type   String   @db.NVarChar(30)
  name         String   @db.NVarChar(100)
  description  String?  @db.NVarChar(256)
  geojson_data String   @db.NVarChar(Max)
  is_active    Boolean  @default(true, map: "DF_MobilityLayers_is_active")
  created_at   DateTime @default(dbgenerated("sysdatetime()"), map: "DF_MobilityLayers_created_at")

  @@schema("geo")
}

model ReportCancellations {
  id                        String      @id(map: "PK_ReportCancellations") @default(dbgenerated("newsequentialid()"), map: "DF_ReportCancellations_id") @db.UniqueIdentifier
  report_id                 String      @unique(map: "UQ_ReportCancellations_report_id") @db.UniqueIdentifier
  cancelled_by_authority_id String      @db.UniqueIdentifier
  cancellation_reason       String      @db.NVarChar(500)
  penalty_applied_to_user   Boolean     @default(false, map: "DF_ReportCancellations_penalty")
  cancelled_at              DateTime    @default(dbgenerated("sysdatetime()"), map: "DF_ReportCancellations_cancelled_at")
  Authorities               Authorities @relation(fields: [cancelled_by_authority_id], references: [id], onUpdate: NoAction, map: "FK_ReportCancellations_Authorities")
  Reports                   Reports     @relation(fields: [report_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_ReportCancellations_Reports")

  @@schema("core")
}

model ReportConfirmations {
  id           String      @id(map: "PK_ReportConfirmations") @default(dbgenerated("newsequentialid()"), map: "DF_ReportConfirmations_id") @db.UniqueIdentifier
  report_id    String      @db.UniqueIdentifier
  authority_id String      @db.UniqueIdentifier
  notes        String?     @db.NVarChar(500)
  confirmed_at DateTime    @default(dbgenerated("sysdatetime()"), map: "DF_ReportConfirmations_confirmed_at")
  Authorities  Authorities @relation(fields: [authority_id], references: [id], onUpdate: NoAction, map: "FK_ReportConfirmations_Authorities")
  Reports      Reports     @relation(fields: [report_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_ReportConfirmations_Reports")

  @@schema("core")
}

model ReportRatings {
  id             String   @id(map: "PK_ReportRatings") @default(dbgenerated("newsequentialid()"), map: "DF_ReportRatings_id") @db.UniqueIdentifier
  report_id      String   @db.UniqueIdentifier
  user_id        String   @db.UniqueIdentifier
  rating_type    String   @db.NVarChar(10)
  user_latitude  Decimal? @db.Decimal(9, 6)
  user_longitude Decimal? @db.Decimal(9, 6)
  created_at     DateTime @default(dbgenerated("sysdatetime()"), map: "DF_ReportRatings_created_at")
  Reports        Reports  @relation(fields: [report_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_ReportRatings_Reports")
  Users          Users    @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "FK_ReportRatings_Users")

  @@unique([report_id, user_id], map: "UQ_ReportRatings_User_Report")
  @@index([report_id, user_id], map: "IX_ReportRatings_ReportUser")
  @@schema("social")
}

model ReportResolutions {
  id                       String      @id(map: "PK_ReportResolutions") @default(dbgenerated("newsequentialid()"), map: "DF_ReportResolutions_id") @db.UniqueIdentifier
  report_id                String      @unique(map: "UQ_ReportResolutions_report_id") @db.UniqueIdentifier
  resolved_by_authority_id String      @db.UniqueIdentifier
  resolution_notes         String?     @db.NVarChar(500)
  resolution_photo_url     String?     @db.NVarChar(512)
  resolved_at              DateTime    @default(dbgenerated("sysdatetime()"), map: "DF_ReportResolutions_resolved_at")
  Authorities              Authorities @relation(fields: [resolved_by_authority_id], references: [id], onUpdate: NoAction, map: "FK_ReportResolutions_Authorities")
  Reports                  Reports     @relation(fields: [report_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_ReportResolutions_Reports")

  @@schema("core")
}

model Reports {
  id                             String                @id(map: "PK_Reports") @default(dbgenerated("newsequentialid()"), map: "DF_Reports_id") @db.UniqueIdentifier
  user_id                        String                @db.UniqueIdentifier
  incident_type_id               Int
  report_type                    String                @db.NVarChar(20)
  title                          String                @db.NVarChar(150)
  description                    String?
  street_osm_id                  String                @db.NVarChar(64)
  street_name                    String?               @db.NVarChar(256)
  latitude                       Decimal               @db.Decimal(9, 6)
  longitude                      Decimal               @db.Decimal(9, 6)
  status                         String                @default("Reportado", map: "DF_Reports_status") @db.NVarChar(20)
  evidence_photo_url             String?               @db.NVarChar(512)
  positive_votes                 Int                   @default(0, map: "DF_Reports_positive_votes")
  negative_votes                 Int                   @default(0, map: "DF_Reports_negative_votes")
  reward_granted                 Boolean               @default(false, map: "DF_Reports_reward_granted")
  scheduled_start_at             DateTime?
  scheduled_end_at               DateTime?
  expires_at                     DateTime
  resolved_at                    DateTime?
  created_at                     DateTime              @default(dbgenerated("sysdatetime()"), map: "DF_Reports_created_at")
  updated_at                     DateTime              @default(dbgenerated("sysdatetime()"), map: "DF_Reports_updated_at")
  status_changed_by_authority_id String?               @db.UniqueIdentifier
  status_changed_at              DateTime?
  Denuncias                      Denuncias[]
  ReportCancellations            ReportCancellations?
  ReportConfirmations            ReportConfirmations[]
  ReportRatings                  ReportRatings[]
  ReportResolutions              ReportResolutions?
  Authorities                    Authorities?          @relation(fields: [status_changed_by_authority_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Reports_Authorities_StatusModifier")
  IncidentTypes                  IncidentTypes         @relation(fields: [incident_type_id], references: [id], onUpdate: NoAction, map: "FK_Reports_IncidentTypes")
  Users                          Users                 @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "FK_Reports_Users")
  UserActionLogs                 UserActionLogs[]

  @@index([status, expires_at], map: "IX_Reports_Expiration")
  @@schema("core")
}

model UserActionLogs {
  id                  String   @id(map: "PK_UserActionLogs") @default(dbgenerated("newsequentialid()"), map: "DF_UserActionLogs_id") @db.UniqueIdentifier
  user_id             String   @db.UniqueIdentifier
  action_type         String   @db.NVarChar(50)
  points_awarded      Int
  reputation_change   Int      @default(0, map: "DF_UserActionLogs_reputation_change")
  reference_report_id String?  @db.UniqueIdentifier
  created_at          DateTime @default(dbgenerated("sysdatetime()"), map: "DF_UserActionLogs_created_at")
  Reports             Reports? @relation(fields: [reference_report_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_UserActionLogs_Reports")
  Users               Users    @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "FK_UserActionLogs_Users")

  @@schema("gamification")
}

model UserBadges {
  id          String   @id(map: "PK_UserBadges") @default(dbgenerated("newsequentialid()"), map: "DF_UserBadges_id") @db.UniqueIdentifier
  user_id     String   @db.UniqueIdentifier
  badge_id    Int
  is_equipped Boolean  @default(false, map: "DF_UserBadges_is_equipped")
  unlocked_at DateTime @default(dbgenerated("sysdatetime()"), map: "DF_UserBadges_unlocked_at")
  Badges      Badges   @relation(fields: [badge_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_UserBadges_Badges")
  Users       Users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_UserBadges_Users")

  @@unique([user_id, badge_id], map: "UQ_UserBadges_User_Badge")
  @@index([user_id, is_equipped], map: "IX_UserBadges_UserEquipped")
  @@schema("gamification")
}

model Users {
  id                                          String                 @id(map: "PK_Users") @default(dbgenerated("newsequentialid()"), map: "DF_Users_id") @db.UniqueIdentifier
  clerk_id                                    String                 @unique(map: "UQ_Users_clerk_id") @db.NVarChar(128)
  email                                       String                 @unique(map: "UQ_Users_email") @db.NVarChar(256)
  first_name                                  String?                @db.NVarChar(100)
  last_name_paternal                          String?                @db.NVarChar(100)
  last_name_maternal                          String?                @db.NVarChar(100)
  avatar_url                                  String?                @db.NVarChar(512)
  role                                        String                 @default("CIUDADANO", map: "DF_Users_role") @db.NVarChar(20)
  status                                      String                 @default("ACTIVE", map: "DF_Users_status") @db.NVarChar(20)
  reputation_points                           Int                    @default(100, map: "DF_Users_reputation_points")
  action_points                               Int                    @default(0, map: "DF_Users_action_points")
  collaboration_level                         Int                    @default(1, map: "DF_Users_collaboration_level")
  created_at                                  DateTime               @default(dbgenerated("sysdatetime()"), map: "DF_Users_created_at")
  updated_at                                  DateTime               @default(dbgenerated("sysdatetime()"), map: "DF_Users_updated_at")
  Authorities                                 Authorities?
  Denuncias_Denuncias_reported_user_idToUsers Denuncias[]            @relation("Denuncias_reported_user_idToUsers")
  Denuncias_Denuncias_reporter_user_idToUsers Denuncias[]            @relation("Denuncias_reporter_user_idToUsers")
  OfficialReportThanks                        OfficialReportThanks[]
  ReportRatings                               ReportRatings[]
  Reports                                     Reports[]
  UserActionLogs                              UserActionLogs[]
  UserBadges                                  UserBadges[]

  @@index([clerk_id], map: "IX_Users_ClerkId")
  @@schema("auth")
}

model OfficialReports {
  id                   String                 @id(map: "PK_OfficialReports") @default(dbgenerated("newsequentialid()"), map: "DF_OfficialReports_id") @db.UniqueIdentifier
  authority_id         String                 @db.UniqueIdentifier
  folio                String?                @db.NVarChar(100)
  street_name          String                 @db.NVarChar(256)
  between_street_1     String?                @db.NVarChar(150)
  between_street_2     String?                @db.NVarChar(150)
  neighborhood         String?                @db.NVarChar(150)
  latitude             Decimal                @db.Decimal(9, 6)
  longitude            Decimal                @db.Decimal(9, 6)
  incident_type_id     Int
  scheduled_start_at   DateTime
  scheduled_end_at     DateTime
  impact_level         String                 @db.NVarChar(50)
  alternative_route    String?                @db.NVarChar(500)
  affected_transport   String?                @db.NVarChar(500)
  status               String                 @default("Reportado", map: "DF_OfficialReports_status") @db.NVarChar(20)
  created_at           DateTime               @default(dbgenerated("sysdatetime()"), map: "DF_OfficialReports_created_at")
  updated_at           DateTime               @default(dbgenerated("sysdatetime()"), map: "DF_OfficialReports_updated_at")
  thanks_count         Int                    @default(0, map: "DF_OfficialReports_thanks_count")
  Authorities          Authorities            @relation(fields: [authority_id], references: [id], onUpdate: NoAction, map: "FK_OfficialReports_Authorities")
  IncidentTypes        IncidentTypes          @relation(fields: [incident_type_id], references: [id], onUpdate: NoAction, map: "FK_OfficialReports_IncidentTypes")
  OfficialReportThanks OfficialReportThanks[]

  @@schema("core")
}

model OfficialReportThanks {
  id                 String          @id(map: "PK_OfficialReportThanks") @default(dbgenerated("newsequentialid()"), map: "DF_OfficialReportThanks_id") @db.UniqueIdentifier
  official_report_id String          @db.UniqueIdentifier
  user_id            String          @db.UniqueIdentifier
  created_at         DateTime        @default(dbgenerated("sysdatetime()"), map: "DF_OfficialReportThanks_created_at")
  OfficialReports    OfficialReports @relation(fields: [official_report_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_OfficialReportThanks_OfficialReports")
  Users              Users           @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "FK_OfficialReportThanks_Users")

  @@unique([official_report_id, user_id], map: "UQ_OfficialReportThanks_Report_User")
  @@schema("social")
}
